# Safe template only. Replace owner TODO values in an ignored local .env file.
# Do not put real credentials or certificates in this file or the repository.
DEMO_MODE=offline
LIVE_ACCESS_APPROVED=false
LIVE_UI_ENABLED=false
AI_GATEWAY_HOST_PORT=8000
WEB_HOST_PORT=3000

# Konnect AI Gateway DP inputs supplied by the control-plane owner; these .invalid
# endpoints are deliberate placeholders and cannot connect to Konnect.
KONNECT_CP_HOST=replace-with-konnect-control-plane.invalid:443
KONNECT_CP_SERVER_NAME=replace-with-konnect-control-plane.invalid
KONNECT_TELEMETRY_HOST=replace-with-konnect-telemetry.invalid:443
KONNECT_TELEMETRY_SERVER_NAME=replace-with-konnect-telemetry.invalid
KONNECT_DP_CERT_PATH=./certs/cluster.crt
KONNECT_DP_KEY_PATH=./certs/cluster.key

# Candidate route/alias from config/konnect-ai-gateway/model-normal.json only;
# owner must confirm the entity, bearer-compatible auth, and target policy.
AI_GATEWAY_BASE_URL=http://ai-gateway:8000/v1/insurance-normal
AI_GATEWAY_API_KEY=REPLACE_WITH_OWNER_ISSUED_INBOUND_CREDENTIAL
AI_GATEWAY_MODEL=insurance-normal
AI_GATEWAY_TIMEOUT_MS=
AI_GATEWAY_REQUEST_BUDGET=

# Candidate native TypeSafe/decisions route; this is not a Chat Completions endpoint.
AI_GATEWAY_JEV_URL=http://ai-gateway:8000/jev/v1/systemone
AI_GATEWAY_JEV_API_KEY=REPLACE_WITH_OWNER_ISSUED_INBOUND_CREDENTIAL
AI_GATEWAY_JEV_MODEL=insurance-jev-decisions
AI_GATEWAY_JEV_TIMEOUT_MS=
AI_GATEWAY_JEV_ATTEMPT_BUDGET=

# Candidate Konnect AI MCP Server routes from config/konnect-ai-gateway/mcp-*.json.
# REST containers alone are not MCP servers; the owner must create/provision routes.
MCP_CUSTOMER_URL=http://ai-gateway:8000/mcp/customer
MCP_PRODUCT_URL=http://ai-gateway:8000/mcp/product
MCP_APPLICATION_URL=http://ai-gateway:8000/mcp/application
MCP_CLAIM_URL=http://ai-gateway:8000/mcp/claim
MCP_POLICY_URL=http://ai-gateway:8000/mcp/policy
# Separate owner-issued key-auth credential used only for the shared `apikey`
# header on the five AI MCP Server endpoints (not the normal SDK Bearer key).
MCP_API_KEY=
MCP_TIMEOUT_MS=
MCP_TOOL_INVOCATION_BUDGET=
