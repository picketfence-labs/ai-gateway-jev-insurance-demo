# 安全なひな形のみ。構築用の秘密と生成された接続値はGit管理外のローカルファイルへ保存します。
# 実際の認証情報や証明書をこのファイルやリポジトリへ保存しないでください。
DEMO_MODE=offline
LIVE_ACCESS_APPROVED=false
LIVE_UI_ENABLED=false
AI_GATEWAY_HOST_PORT=8000
WEB_HOST_PORT=3000

# Konnect AI Gateway DPの接続先はTerraformのoutputから生成します。
# .invalid は意図的なプレースホルダーで、Konnectには接続できません。
KONNECT_CP_HOST=replace-with-konnect-control-plane.invalid:443
KONNECT_CP_SERVER_NAME=replace-with-konnect-control-plane.invalid
KONNECT_TELEMETRY_HOST=replace-with-konnect-telemetry.invalid:443
KONNECT_TELEMETRY_SERVER_NAME=replace-with-konnect-telemetry.invalid
KONNECT_DP_CERT_PATH=./certs/cluster.crt
KONNECT_DP_KEY_PATH=./certs/cluster.key

# config/konnect-ai-gateway/kongctl/ai-gateway.yaml の通常Model経路・別名です。
# 通常Model用のinbound AI Consumer credentialは `apikey` headerで送ります。
AI_GATEWAY_BASE_URL=http://ai-gateway:8000/v1/insurance-normal
AI_GATEWAY_API_KEY=REPLACE_WITH_LOCAL_INBOUND_CREDENTIAL
AI_GATEWAY_MODEL=insurance-normal
AI_GATEWAY_TIMEOUT_MS=20000

# TypeSafe / decisions向けのnative経路です。Chat Completions用endpointではありません。
# Jev用のinbound AI Consumer credentialは通常Model用とは別にし、`apikey` headerで送ります。
AI_GATEWAY_JEV_URL=http://ai-gateway:8000/jev/v1/systemone
AI_GATEWAY_JEV_API_KEY=REPLACE_WITH_LOCAL_INBOUND_CREDENTIAL
AI_GATEWAY_JEV_MODEL=insurance-jev-decisions
AI_GATEWAY_JEV_TIMEOUT_MS=10000

# kongctlの宣言設定に基づくKonnect AI MCP Server経路です。
# RESTコンテナだけではMCP Serverになりません。MCPの設定はkongctlで適用します。
MCP_CUSTOMER_URL=http://ai-gateway:8000/mcp/customer
MCP_PRODUCT_URL=http://ai-gateway:8000/mcp/product
MCP_APPLICATION_URL=http://ai-gateway:8000/mcp/application
MCP_CLAIM_URL=http://ai-gateway:8000/mcp/claim
MCP_POLICY_URL=http://ai-gateway:8000/mcp/policy
# MCP用inbound AI Consumer credentialです。5つのAI MCP Serverへ `apikey` headerで送ります。
# 通常Model/Jev用のcredentialやProvider outbound keyとは別にしてください。
MCP_API_KEY=
MCP_TIMEOUT_MS=5000
