{
  "display_name": "Insurance Demo Policy MCP (owner review)",
  "name": "insurance-demo-policy-mcp",
  "type": "conversion-listener",
  "enabled": false,
  "access": { "auth_strategies": ["insurance-demo-mcp-key-auth"] },
  "config": {
    "url": "http://policy-api:8000",
    "route": { "paths": ["/mcp/policy"] },
    "logging": { "payloads": false }
  },
  "tools": [
    {
      "name": "get_policy_policies__policy_id__get",
      "description": "Read one synthetic policy detail for the current insurance case.",
      "method": "GET",
      "path": "/mcp/policy/policies/{policy_id}",
      "annotations": { "title": "Get policy detail", "readOnlyHint": true, "destructiveHint": false },
      "parameters": [{ "name": "policy_id", "in": "path", "required": true, "schema": { "type": "string" } }]
    }
  ]
}
